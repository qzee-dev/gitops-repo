apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-dns01
spec:
  acme:
    # Use the staging endpoint while testing, then switch to production.
    server: https://acme-staging-v02.api.letsencrypt.org/directory
    email: replace-with-operations-email@example.com
    privateKeySecretRef:
      name: letsencrypt-dns01-account
    solvers:
      - selector:
          dnsZones:
            - dev.example.com
        dns01:
          route53:
            region: us-east-1
            hostedZoneID: REPLACE_WITH_ROUTE53_ZONE_ID
